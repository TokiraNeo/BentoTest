{
  "name": "bento-test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "description": "Echo host for verifying the Bento Hub protocol.",
  "scripts": {
    "dev": "tsx src/index.ts",
